# Amadeus API credentials
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Watson AI credentials
WATSON_APIKEY=your_watson_api_key_here
PROJECT_ID=your_watson_project_id_here

# LLM fallback configuration
USE_FALLBACK=false

# Database configuration
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ask_travel
DATABASE_URL=postgresql+asyncpg://postgres:your_encoded_password@localhost:5432/ask_travel

# JWT Authentication
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP Email configuration
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=8025
SMTP_USER=your_smtp_user_here
SMTP_FROM_EMAIL=your_email@example.com
SMTP_PASSWORD=your_smtp_password_here

# Environment mode: "dev" for development (uses HuggingFace/RapidOCR), "prod" for production (uses VLMM API)
env=dev